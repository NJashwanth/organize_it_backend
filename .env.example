# Copy this file to .env and fill in real values
# cp .env.example .env

SPRING_APPLICATION_NAME=organize_it_backend
DEBUG=true

# Required: MongoDB connection string
SPRING_DATA_MONGODB_URI=<your-mongodb-uri>
SPRING_DATA_MONGODB_DATABASE=organize-it-backend

# Required: Basic auth credentials
SPRING_SECURITY_USER_NAME=<your-username>
SPRING_SECURITY_USER_PASSWORD=<your-strong-password>
